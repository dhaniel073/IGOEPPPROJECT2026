{
  "expo": {
    "name": "igohelptest",
    "slug": "igoeppCus",
    "version": "1.10.9",
    "orientation": "portrait",
    "icon": "./assets/images/icon1.png",
    "scheme": "igohelp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "jsEngine": "hermes",
      "infoPlist": {
        "NSUserTrackingUsageDescription": "We use notifications to keep you updated.",
        "NSLocationWhenInUseUsageDescription": "This app requires access to your location to show nearby artisans."
      }
    },
    "android": {
      "jsEngine": "hermes",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icon1.png",
        "backgroundImage": "./assets/images/icon1.png",
        "monochromeImage": "./assets/images/icon1.png"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECORD_AUDIO",
        "NOTIFICATIONS",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "package": "com.dhanieldcoder.igoeppCus",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCpbcKH5Vz-YO69y0_0XGh-LweerrsD3d0"
        }
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "allowBackup": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/loader.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#161719"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false,
            "minSdkVersion": 29
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "aesBase64Key": "kVGlKQ72B2OIRvc9UyTXyGMCiZF3cpA72fC8CKKL7S0=",
      "router": {},
      "eas": {
        "projectId": "2c75ad4c-ecdd-4966-b765-1f5024bd5212"
      }
    }
  }
}